<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiCardSync.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MultiCardSync.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="820" Height="640" MinWidth="680" MinHeight="520"
        Title="MultiCard → Sheet Sync">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="18">

    <!-- Header: holat nuqtasi + nom + holat matni -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <Ellipse Width="14" Height="14" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
      <TextBlock Text="MultiCard → Sheet Sync" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Border Background="#22808080" CornerRadius="10" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <!-- Statistika + ikkilamchi boshqaruv -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,18,0,12">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="28">
        <StackPanel>
          <TextBlock Text="Jami yozilgan" Opacity="0.6" FontSize="12" />
          <TextBlock Text="{Binding TotalSynced}" FontSize="24" FontWeight="Bold" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Oxirgi sinxron" Opacity="0.6" FontSize="12" />
          <TextBlock Text="{Binding LastSyncText}" FontSize="16" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Davr" Opacity="0.6" FontSize="12" />
          <TextBlock Text="{Binding PollIntervalText}" FontSize="16" Margin="0,4,0,0" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="🔄 Hozir sinxronla" Command="{Binding SyncNowCommand}" IsEnabled="{Binding NotBusy}" />
        <Button Content="{Binding ToggleButtonText}" Command="{Binding ToggleCommand}" />
        <Button Content="📊 Sheet" Command="{Binding OpenSheetCommand}" />
      </StackPanel>
    </Grid>

    <!-- Asosiy qo'lda oqim: tortib olish → "Tortib olingan" tabida har qatorni 📤 bilan yozish -->
    <Border Grid.Row="2" Background="#14808080" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Content="⬇️ Tortib olish"
                Command="{Binding FetchDataCommand}"
                IsEnabled="{Binding NotBusy}" />
        <TextBlock Text="{Binding PreviewSummary}" Opacity="0.7" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Tab: sinxron tarixi / tortib olingan preview / log -->
    <TabControl Grid.Row="3">

      <TabItem Header="🧾 Sinxron tarixi">
        <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,8,0,0">
          <DataGrid ItemsSource="{Binding Transactions}"
                    x:CompileBindings="False"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Sana" Binding="{Binding Date}" Width="105" />
              <DataGridTextColumn Header="Yo'nalish" Binding="{Binding Direction}" Width="95" />
              <DataGridTextColumn Header="Summa" Binding="{Binding Amount}" Width="120" />
              <DataGridTextColumn Header="Izoh" Binding="{Binding Note}" Width="*" />
              <DataGridTextColumn Header="Holat" Binding="{Binding Status}" Width="110" />
              <DataGridTextColumn Header="Sinxron" Binding="{Binding SyncedAt}" Width="105" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </TabItem>

      <TabItem Header="⬇️ Tortib olingan">
        <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,8,0,0">
          <DataGrid ItemsSource="{Binding PreviewRows}"
                    x:CompileBindings="False"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Sana / vaqt" Binding="{Binding Date}" Width="150" />
              <DataGridTextColumn Header="Yo'nalish" Binding="{Binding Direction}" Width="90" />
              <DataGridTextColumn Header="Summa" Binding="{Binding Amount}" Width="115" />
              <DataGridTextColumn Header="Izoh" Binding="{Binding Note}" Width="*" />
              <DataGridTextColumn Header="Holat" Binding="{Binding State}" Width="130" />
              <DataGridTemplateColumn Header="Amal" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="📤 Yozish"
                            Command="{Binding WriteRowCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="4,3" Padding="6,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </TabItem>

      <TabItem Header="📜 Log">
        <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,8,0,0">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Logs}" Margin="10,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntryViewModel">
                  <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                    <TextBlock Grid.Column="0" Text="{Binding Time}" Opacity="0.55"
                               FontFamily="Cascadia Mono,Menlo,Consolas,monospace" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}"
                               FontFamily="Cascadia Mono,Menlo,Consolas,monospace" FontWeight="SemiBold"
                               Width="44" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono,Menlo,Consolas,monospace" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </TabItem>

    </TabControl>

    <!-- Footer: startup checkbox -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Margin="0,12,0,0" VerticalAlignment="Center">
      <CheckBox Content="Windows startup'da avtomatik ishga tushsin"
                IsChecked="{Binding StartupRegistered, Mode=OneWay}"
                Command="{Binding ToggleStartupCommand}"
                IsEnabled="{Binding StartupSupported}" />
      <TextBlock Text="Kompyuter yoqilganda ilova o'zi ishga tushadi va sheetni sinxronlaydi."
                 Opacity="0.55" FontSize="12" VerticalAlignment="Center" />
    </StackPanel>

  </Grid>
</Window>
